rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /hinker/{docId} {
      // All authenticated users can read (needed for discover/swipe/shared lists)
      allow read: if request.auth != null;

      // Shared collections that multiple users need to write
      allow write: if request.auth != null && (
        docId == "hk_emp_jobs" ||
        docId == "hk_all_applicants" ||
        docId.matches("hk_chat_.*")
      );

      // User-specific docs: only the owner (their email appears in the doc ID)
      allow write: if request.auth != null &&
        docId.matches(".*" + request.auth.token.email + ".*");
    }
  }
}
